    {
      "parameters": {
        "jsCode": "// 1. Obtenemos la lista completa de respuestas de IA y la lista de leads originales\nconst iaItems = $input.all();\nconst originalLeads = $('Edit Fields').all();\n\n// 2. Iteramos sobre cada ítem para emparejarlos por su posición/índice\nreturn iaItems.map((item, index) => {\n  const rawResponse = item.json.text || item.json.output || item.json;\n  const leadOriginal = originalLeads[index]?.json || {};\n  \n  let data = {};\n\n  try {\n    if (typeof rawResponse === 'object' && rawResponse !== null) {\n      data = rawResponse;\n    } else {\n      const cleanJson = String(rawResponse)\n        .replace(/```json/gi, '')\n        .replace(/```/g, '')\n        .trim();\n      data = JSON.parse(cleanJson);\n    }\n  } catch (error) {\n    data = {\n      Empresa_Grande: false,\n      Resumen: \"Error al interpretar JSON de la IA.\",\n      Sugerencia: \"Revisar respuesta manualmente.\"\n    };\n  }\n\n  return {\n    json: {\n      Empresa_Grande: Boolean(data.Empresa_Grande),\n      Resumen: data.Resumen || 'Sin resumen disponible.',\n      Sugerencia: data.Sugerencia || 'Sin sugerencia.',\n      nombre: leadOriginal.nombre || 'N/A',\n      correo: leadOriginal.correo || 'N/A',\n      telefono: leadOriginal.telefono || 'N/A'\n    }\n  };\n});"
      },
