      "retryOnFail": false,
      "notesInFlow": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Capturamos el arreglo de elementos de n8n\nconst items = $input.all();\n\nconst resultado = items.map(item => {\n  const direccionCompleta = (item.json.direccion || \"\").trim();\n  \n  // Valores por defecto inteligentes por si el string viene vacío\n  let line1 = \"\";\n  let city = \"Springfield\";\n  let postal_code = \"62704\";\n\n  // 1. BLINDAJE CÓDIGO POSTAL: Buscamos 5 números seguidos con Regex (Ej: 62704)\n  const cpMatch = direccionCompleta.match(/\\b\\d{5}\\b/);\n  if (cpMatch) {\n    postal_code = cpMatch[0];\n  }\n\n  // Limpiamos la dirección quitándole el código postal que ya encontramos\n  let textoSinCP = direccionCompleta.replace(postal_code, \"\").trim();\n  \n  // Quitamos comas sueltas que hayan quedado al final tras quitar el CP\n  if (textoSinCP.endsWith(',')) {\n    textoSinCP = textoSinCP.slice(0, -1).trim();\n  }\n\n  // 2. BLINDAJE CALLE Y CIUDAD: ¿Tiene comas?\n  if (textoSinCP.includes(',')) {\n    // Caso ideal: \"Av. Siempre Viva 742, Springfield\"\n    const partes = textoSinCP.split(',');\n    line1 = partes[0].trim();\n    city = partes[1] ? partes[1].trim() : \"Springfield\";\n  } else {\n    // Caso de crisis (Sin comas): \"Av Siempre Viva 742 Springfield\"\n    const palabras = textoSinCP.split(/\\s+/); // Separamos por espacios\n    \n    if (palabras.length > 1) {\n      city = palabras.pop(); // Extraemos la última palabra y asumimos que es la ciudad\n      line1 = palabras.join(\" \"); // Todo lo anterior es la calle\n    } else {\n      line1 = textoSinCP || \"Dirección no especificada\";\n    }\n  }\n\n  // Creamos la estructura limpia para Stripe\n  const direccionDesglosada = {\n    line1: line1,\n    city: city,\n    postal_code: postal_code\n  };\n\n  return {\n    json: {\n      ...item.json,\n      direccion_limpia: direccionDesglosada\n    }\n  };\n});\n\nreturn resultado;"
      },
